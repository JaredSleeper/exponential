# ---- core ----
# Secret for signing session cookies. Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production
# e.g. https://exponential.fly.dev or https://exponential.nyc
APP_BASE_URL=http://localhost:8000
# dev | staging | production
ENVIRONMENT=dev
# sqlite:///exponential.db (default) or postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///exponential.db
# SESSION_COOKIE_SECURE=true in production (https only)
SESSION_COOKIE_SECURE=false

# ---- admins ----
# Comma-separated emails. First sign-in with a matching email gets admin.
ADMIN_EMAILS=you@example.com,cohost@example.com

# ---- auth ----
# clerk (production) | dev (local email+code, no external services)
AUTH_PROVIDER=dev
# Clerk Dashboard → your app → API keys:
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional; derived from the publishable key if unset.
CLERK_JWKS_URL=

# ---- email ----
# console (writes to logs + admin outbox) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Verified sender, e.g. "Exponential Collective <hello@exponential.nyc>"
EMAIL_FROM=Exponential Collective <hello@exponential.nyc>
# Hard safety switch: true = never deliver anything, regardless of provider
EMAIL_DISABLE_SENDS=true

# ---- media ----
# local | s3
STORAGE_BACKEND=local
MEDIA_DIR=media
# S3 (or compatible) for production:
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- admissions ----
MEMBER_CAP=80
INVITE_TTL_DAYS=14

# ---- dev only ----
# true = create 10 FICTIONAL members + demo events on startup (never in prod)
SEED_DEMO_DATA=false
